<Window x:Class="DWSInterface.QueryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        xmlns:local="clr-namespace:DWSInterface"
         xmlns:i="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity"
        mc:Ignorable="d"
        Title="查询" Height="720" Width="1280" Background="#69839C" Closing="Window_Closing" ResizeMode="NoResize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="0.9*"/>
            <RowDefinition Height="1.1*"/>
            <RowDefinition Height="0.5*"/>
            <RowDefinition Height="16.6*"/>
            <RowDefinition Height="0.9*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.5*"/>
            <ColumnDefinition Width="19*"/>
            <ColumnDefinition Width="0.5*"/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Row="1" Grid.Column="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4.5*"/>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="0.5*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <StackPanel Orientation="Horizontal">
                    <Label Content="{Binding SearchTimeTitle}" Margin="0,-1,0,0" VerticalAlignment="Center" Foreground="white" FontSize="15"/>
                    <xctk:DateTimePicker Text="{Binding StartTime, Mode=OneWayToSource}" x:Name="StartDateTime" Width="200" FontSize="15" Format="Custom" VerticalAlignment="Center" TextAlignment="Left" FormatString="yyyy/MM/dd HH:mm:ss" />
                    <Label Content="  -  " Margin="0,-1,0,0" VerticalAlignment="Center" Foreground="white" FontSize="15"/>
                    <xctk:DateTimePicker Text="{Binding EndTime, Mode=OneWayToSource}" x:Name="EndDateTime" Width="200" FontSize="15" Format="Custom" VerticalAlignment="Center" TextAlignment="Left" FormatString="yyyy/MM/dd HH:mm:ss" />
                </StackPanel>
            </Grid>
            <Grid Grid.Column="1">
                <StackPanel Orientation="Horizontal">
                    <Label Content="{Binding SearchCodeTitle}" Margin="0,-1,0,0" VerticalAlignment="Center" Foreground="white" FontSize="15"/>
                    <TextBox Text="{Binding Barcode, Mode=OneWayToSource}" Width="400"  Margin="0,-1,0,0" VerticalAlignment="Center" Foreground="Black" FontSize="15"/>
                </StackPanel>
            </Grid>
            <Grid Grid.Column="3">
                <StackPanel Orientation="Horizontal">
                    <Label Content="{Binding SearchDestTitle}" Margin="0,-1,0,0" VerticalAlignment="Center" Foreground="white" FontSize="15"/>
                    <TextBox Text="{Binding Destination, Mode=OneWayToSource}" Width="200"  Margin="0,-1,0,0" VerticalAlignment="Center" Foreground="Black" FontSize="15"/>
                </StackPanel>
            </Grid>
        </Grid>
        <Grid Grid.Row="3" Grid.Column="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="998*"/>
                <ColumnDefinition Width="16*"/>
                <ColumnDefinition Width="195*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="18.5*"/>
                <RowDefinition Height="0.5*"/>
                <RowDefinition Height="1*"/>
            </Grid.RowDefinitions>
            <DataGrid x:Name="DataGridHis" RowHeaderWidth="0" GridLinesVisibility="None" BorderThickness="0" Grid.Row="0" ItemsSource="{Binding TempSource, Mode=OneWay}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" Grid.ColumnSpan="3" Margin="0,0,-0.4,14" Grid.RowSpan="2">
                <DataGrid.Resources>
                    <Style TargetType="ScrollViewer">
                        <Setter Property="HorizontalScrollBarVisibility" Value="Hidden"/>
                        <Setter Property="VerticalScrollBarVisibility" Value="Hidden"/>
                    </Style>
                    <Style TargetType="{x:Type DataGridRow}">
                        <Setter Property="Height" Value="25"/>
                    </Style>
                    <Style x:Key="contentstyle" TargetType="{x:Type TextBlock}">
                        <Setter Property="TextAlignment" Value="Center" />
                        <Setter Property="VerticalAlignment" Value="Center"/>

                    </Style>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                    </Style>
                </DataGrid.Resources>
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="BorderBrush" Value="LightGray"/>
                    </Style>
                </DataGrid.CellStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="" CanUserSort="False" Binding="{Binding Id}" Width="1*" ElementStyle="{StaticResource contentstyle}">
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DataContext.IDTitle,RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="" CanUserSort="False" Binding="{Binding Code}" Width="4*" ElementStyle="{StaticResource contentstyle}">
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DataContext.BarcodeTitle,RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="" CanUserSort="False" Binding="{Binding Destination}" Width="2*" ElementStyle="{StaticResource contentstyle}">
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DataContext.DestTitle,RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="" CanUserSort="False" Binding="{Binding Length}" Width="2*" ElementStyle="{StaticResource contentstyle}">
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DataContext.LengthTitle,RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="" CanUserSort="False" Binding="{Binding Width}" Width="2*" ElementStyle="{StaticResource contentstyle}">
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DataContext.WidthTitle,RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="" CanUserSort="False" Binding="{Binding Height}" Width="2*" ElementStyle="{StaticResource contentstyle}">
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DataContext.HeightTitle,RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="" CanUserSort="False" Binding="{Binding Volume}" Width="4*" ElementStyle="{StaticResource contentstyle}">
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DataContext.VolumeTitle,RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="" CanUserSort="False" Binding="{Binding Weight}" Width="2*" ElementStyle="{StaticResource contentstyle}">
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DataContext.WeightTitle,RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="" CanUserSort="False" Binding="{Binding TimeStamp}" Width="3*" ElementStyle="{StaticResource contentstyle}">
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DataContext.TimestampTitle,RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>
                    <DataGridTemplateColumn Header="" CanUserSort="False" Width="2*">
                        <DataGridTemplateColumn.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DataContext.PicTitle,RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.HeaderTemplate>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Image MouseUp="Image_MouseUP" Source="pack://application:,,,/Images/imageicon.jpg" Stretch="Uniform" HorizontalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <local:Pager Grid.Row="2" HorizontalAlignment="Right" VerticalAlignment="Center" PageTitle="{Binding PageTitle}" TotalTitle="{Binding TotalTitle}" TotalPage="{Binding TotalPage}" CurrentPage="{Binding CurrentPage, Mode=TwoWay}" Grid.ColumnSpan="3" Margin="0,3,-0.4,2.8">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="FirstPage">
                        <i:InvokeCommandAction Command="{Binding FirstPageCommand}" />
                    </i:EventTrigger>
                    <i:EventTrigger EventName="PreviousPage">
                        <i:InvokeCommandAction Command="{Binding PreviousPageCommand}"/>
                    </i:EventTrigger>
                    <i:EventTrigger EventName="NextPage">
                        <i:InvokeCommandAction Command="{Binding NextPageCommand}" />
                    </i:EventTrigger>
                    <i:EventTrigger EventName="LastPage">
                        <i:InvokeCommandAction Command="{Binding LastPageCommand}"/>
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </local:Pager>
            <Button Grid.Row="2" Content="{Binding QueryTitle}" FontSize="15" Click="Button_Click"  HorizontalAlignment="Left" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"  Width="100">
                <Button.Resources>
                    <Style TargetType="{x:Type Border}">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </Button.Resources>
            </Button>
            <TextBlock Grid.Row="2" Width="250" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="15" Text="{Binding ReadRate}" Foreground="White" Margin="500,4,0,4.8">

            </TextBlock>
        </Grid>
    </Grid>
</Window>
